{
  "inputs": [
    {
      "name": "accounts",
      "type": "text",
      "prompt": "Accounts (comma-separated, max 20)",
      "placeholder": "@mosseri, @zuck, @threads"
    },
    {
      "name": "posts_per_account",
      "type": "choices",
      "prompt": "Posts Per Account",
      "choices": "10,25,50",
      "value": "25"
    },
    {
      "name": "refresh_interval",
      "type": "choices",
      "prompt": "Minimum Refresh Interval",
      "choices": "30,60,120",
      "value": "30"
    },
    {
      "name": "include_reposts",
      "type": "switch",
      "prompt": "Include Reposts",
      "value": "off"
    },
    {
      "name": "include_quotes",
      "type": "switch",
      "prompt": "Include Quote Posts",
      "value": "on"
    }
  ]
}
